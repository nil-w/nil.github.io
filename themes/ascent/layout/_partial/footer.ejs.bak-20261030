<% if (theme.intensedebate.enable && theme.intensedebate.acct){ %>
<%- css('css/comments') %>
<% } %>

<% if (is_archive() || is_category() || is_tag()){ %>
<script type="text/javascript">
  let tgl = (s) => {
    x = document.getElementsByName("expand");
    for (let i = 0; i < x.length; i++) x[i].checked = s.checked;
  }
</script>
<% } %>

<% if (theme.settings){ %>
<div id="settings-container">
  <div id="dark-mode"></div>
  <div id="sans-font"></div>
</div>

<span class="post-count"><%- totalcount(site) %></span>
<script type="text/javascript">
  let d = document,
    root = d.documentElement,
    l = localStorage,
    rawS = l.getItem('s'),
    s = (rawS === '1' || rawS === '2') ? Number(rawS) : 0,
    n = l.getItem('n') || '2',
    m = d.getElementById('dark-mode'),
    o = d.getElementById('sans-font'),
    applyTheme = () => {
      root.setAttribute(
        'data-theme',
        s === 1 ? 'light' : s === 2 ? 'dark' : 'auto'
      );
    },
    applyFont = () => {
      root.setAttribute('data-font', n === '1' || n === 1 ? 'sans' : 'serif');
    };
  m.onclick = function () {
    s = s === 2 ? 0 : s + 1;
    l.setItem('s', s);
    applyTheme();
  };
  o.onclick = function () {
    n = (n == 2 || n === '2') ? '1' : '2';
    l.setItem('n', n);
    applyFont();
  };
  applyTheme();
  applyFont();
</script>
<% } %>

<%
  var _body = String(page.content || '');
  var needMermaid = /class=["']mermaid["']/.test(_body);
  var needReveal = /class=["']slides["']/.test(_body);
  var needQr = page.layout === 'post' && /data-qr/.test(_body);
%>

<% if (needMermaid){ %>
<script type="module">
  import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@12.2.0/+esm";
  let theme = localStorage.getItem("s");
  mermaid.initialize({
      startOnLoad: true,
      logLevel: 'error',
      securityLevel: 'strict',
      theme: theme === '2' ? 'forest' : 'dark',
    });
  let mode = document.getElementById("dark-mode");
   let arrayGraphs =  [];
  let nodes = document.getElementsByClassName('mermaid')
  for(let n of nodes){
    arrayGraphs.push(n.innerHTML);
  }

  if (mode) mode.addEventListener("click",async ()=>{
    theme = localStorage.getItem("s");
    mermaid.initialize({
      startOnLoad: true,
      logLevel: 'error',
      securityLevel: 'strict',
      theme: theme === '2' ? 'forest' : 'dark',
    });
  for(let i = 0;i< nodes.length;i++){
      let n =  nodes[i]
      n.removeAttribute("data-processed");
      n.setAttribute("id",`mermaid-${i}`)
      n.replaceChildren();
      n.innerHTML = arrayGraphs[i]
      mermaid.run({ nodes: [n] })
    }
  },false);

  const rerenderMermaid = () => {
    const pending = Array.from(document.querySelectorAll('.mermaid:not([data-processed])'));
    if (pending.length) {
      mermaid.run({ nodes: pending }).catch(() => {});
    }
  };
  window.addEventListener('hexo-blog-decrypt', rerenderMermaid);
  document.addEventListener('hexo-blog-decrypt', rerenderMermaid);

</script>
<% } %>

<% if (theme.google_analytics.enable && theme.google_analytics.acct){ %>
<script type="text/javascript">
</script>
<% } %>

<% if (needQr){ %>
<script src="<%= theme.cdn.jquery %>" defer ></script>
<script src="<%= theme.cdn.qrcode %>" defer ></script>
<script type="module">
  import qrcodeInit from '/js/qrcode.js'
  qrcodeInit();
</script>
<% } %>
<% if (needReveal){ %>
<script src="https://unpkg.com/reveal.js@5.2.1/dist/reveal.js" defer></script>
<script src="https://unpkg.com/reveal.js-mermaid-plugin@11.15.0/plugin/mermaid/mermaid.js" defer></script>
<% } %>
<script type="module">
(function () {
  var poem = document.querySelector('#poem');
  var info = document.querySelector('#info');
  if (!poem || !info) return;

  var cacheKey = 'ascent-poem';
  try {
    var cached = sessionStorage.getItem(cacheKey);
    if (cached) {
      var parsed = JSON.parse(cached);
      if (parsed && parsed.content && parsed.meta) {
        poem.textContent = parsed.content;
        info.textContent = parsed.meta;
        return;
      }
    }
  } catch (e) {}

  var xhr = new XMLHttpRequest();
  xhr.open('get', 'https://v2.jinrishici.com/one.json?client=browser-sdk/1.2');
  xhr.withCredentials = true;
  xhr.onreadystatechange = function () {
    if (xhr.readyState !== 4) return;
    try {
      var data = JSON.parse(xhr.responseText);
      var content = data.data.content;
      var meta = '[' + data.data.origin.dynasty + '] ' + data.data.origin.author + '《' + data.data.origin.title + '》';
      poem.textContent = content;
      info.textContent = meta;
      try {
        sessionStorage.setItem(cacheKey, JSON.stringify({ content: content, meta: meta }));
      } catch (e) {}
    } catch (e) {}
  };
  xhr.send();
})();

(function () {
  var btn = document.querySelector('.hbe-button');
  var password = document.querySelector('#hbePass');
  if (btn) btn.textContent = '重新输入密码';
  if (password) password.setAttribute('autocomplete', 'false');
})();
</script>
