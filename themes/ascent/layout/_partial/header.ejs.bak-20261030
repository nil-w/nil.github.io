<header id="header">
  <nav>
    <div class="header-nav-links">
      <a class="nav-link-first" href="<%- url_for() %>">sudo rm -rf /*</a>
      <span class="nav-spacer"></span>
      <% var keys = Object.keys(theme.menu); %>
      <% for (var i = 0; i < keys.length; i++){ %>
        <% if (i !== 0){ %>
          <span class="nav-spacer"> </span>
        <% } %>
        <a class="nav-link" href="<%- url_for(theme.menu[keys[i]]) %>"><%= __(keys[i]) %></a>
      <% } %>
      <% if (theme.rss){ %>
        <span class="nav-spacer"> </span>
        <a class="nav-link" href="<%- url_for(theme.rss) %>"><%= __('rss_feed') %></a>
      <% } %>
    </div>
    <div class="poem-wrap">
      <p id="poem"></p>
      <p id="info"></p>
      <script>
      (function () {
        try {
          var cached = sessionStorage.getItem('ascent-poem');
          if (!cached) return;
          var parsed = JSON.parse(cached);
          if (!parsed || !parsed.content) return;
          var poem = document.getElementById('poem');
          var info = document.getElementById('info');
          if (poem) poem.textContent = parsed.content;
          if (info) info.textContent = parsed.meta || '';
        } catch (e) {}
      })();
      </script>
    </div>
  </nav>
</header>
