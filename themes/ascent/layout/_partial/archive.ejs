
<% if (page.total > 1){ %>
  <nav id="page-nav" class="page-nav">
    <% var prev_text = "« " + __('prev');var next_text = __('next') + " »"%>
    <%- paginator({
      prev_text: '<',
      next_text: '>'
    }) %>
  </nav>
<% } %>
<% if (pagination == 2){ %>
  <% if (index){ %>
  <section class="site-intro">
    <% if ((page.current || 1) === 1){ %>
    <h1><%= config.title %> · <%= config.site_tagline || config.subtitle %></h1>
    <% } else { %>
    <h1><%= config.title %> · <%= config.site_tagline || config.subtitle %>（第 <%= page.current %> 页）</h1>
    <% } %>
    <p><%= config.description %></p>
    <p class="site-intro-note">记录后端架构与工程实践、AI 与 Agent 落地、独立开发与日常思考——写代码，也写踩过的坑。</p>
    <nav class="site-intro-links">
      <% site.categories.sort('-length').limit(8).each(function(c){ %>
      <a href="<%= url_for(c.path) %>"><%= c.name %><span class="site-intro-count"><%= c.posts.length %></span></a>
      <% }) %>
      <a href="<%= url_for('/archives/') %>">全部文章<span class="site-intro-count"><%= site.posts.length %></span></a>
    </nav>
  </section>
  <% } %>
  <div class="archive-body">
    <% var last; %>
  <% var i = 0; %>
  <% page.posts.each(function(post, i){ %>
    <% var date_obj = post.date; %>
    <% var month = post.date.year(); %>
    <% if (last != month){ %>
      <% if (last != null){ %>
        </div></div>
      <% } %>
      <% last = month; %>
      <% i = i + 1 %>
      <div>
        <h3><%= date(date_obj, "YYYY") %></h3>
        <div class="list-group">
    <% } %>
    <%- partial('archive-post', {class_name: 'list-group-item' ,post: post}) %>
  <% }) %>
  <% if (page.posts.length){ %>
    </div></div>
  <% } %>
  </div>
<% } else { %>
  <div class="archive-wrapper">
  <h1 class="list-header"><%= page.posts.length || 0 %> 文章</h1>
  <div class="archive-body">
    <% var last; %>
  <% var i = 0; %>
  <% page.posts.each(function(post, i){ %>
    <% var date_obj = post.date; %>
    <% var month = post.date.year(); %>
    <% if (last != month){ %>
      <% if (last != null){ %>
        </div></section>
      <% } %>
      <% last = month; %>
      <% i = i + 1 %>
      <section class="archives-wrap">
        <input class="hidden-input" type="checkbox" name="expand" id="<%= 'expand' + i %>">
        <label class="month" for="<%= 'expand' + i %>"><%= date(date_obj, "YYYY") %></label>
        <div class="archives hidden">
    <% } %>
    <%- partial('archive-post', {class_name: '' ,post: post}) %>
  <% }) %>
  <% if (page.posts.length){ %>
    </div></section>
  <% } %>
  </div>

</div>
<% } %>
